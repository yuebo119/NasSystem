<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 传递依赖钉住：只加 PackageVersion 条目对传递依赖不生效（NuGet 的
         CPM 语义是"直接引用才用中央版本"）。开启后中央文件里的版本同样
         作用于传递依赖，ImageSharp 的漏洞修复（见下方版本选择实证）才能落地 -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- PalORM.Sqlite 6.5.0 依赖 Microsoft.Data.Sqlite.Core 11.0.0-rc.1，
         此处统一到同一 major 的 rc.2（高于 PalORM 声明，还原不会降级），
         避免 CPM 把版本钉在 10.0.x 造成还原冲突。
         应用侧在 Infrastructure.csproj 显式引用 Core（代码直接 catch
         Microsoft.Data.Sqlite.SqliteException），使托管包装层与
         tools/Benchmark 的 ADO.NET 地板臂（元包 rc.2 → Core rc.2）同版本，
         基准两臂才口径对等。原生引擎仍是 PalORM 的 SQLite3MC 包。 -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0-rc.2.26504.105" />
    <!-- ImageSharp 经 ElBruno.LocalEmbeddings.ImageEmbeddings（CLIP 预处理）传递进入，
         3.1.12 带 5 条已知漏洞 advisory（NU1902×2 中危 / NU1903×3 高危：
         ICC CLUT 维度未校验越界读、HistogramEqualization 索引未校验、
         BigTIFF IFD 计数死循环、TIFF CCITT T6 编码器缓冲区溢出）。
         版本选择有两段实证：
         ① GitHub Advisory 元数据写「< 3.2.0 受影响 / 3.2.0 已修」，
            但 2026-10-22 强制重新 restore（dotnet restore 带 force 开关）实测：钉 3.2.0 仍报
            5 条 NU1902/NU1903（NuGet 审计数据与 GitHub 元数据不一致）。
         ② 4.x 线的修复版是 4.1.3（advisory patched_versions 明确列出），
            钉 4.1.3 后 restore 零警告。ElBruno 1.6.4 针对 3.x 编译
            （引用版本 3.0.0.0），.NET Core 允许加载更高版本；它用到的
            像素访问 API（ProcessPixelRows）与 ImageEncoder 在 4.x 仍在，
            由 ImageSharpAdvisoryGuardTests 做编译期+运行期双证，
            语义测试 19 例全过。
         同 Microsoft.Data.Sqlite 的模式向上钉版本：ElBruno 对 ImageSharp
         无上界约束，还原不会降级；若将来 ElBruno 升级到要求 3.x 的版本，
         这条钉住会让 restore 直接报冲突而不是静默降级 -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <!-- OCR（ROADMAP Phase 2）：SimdPaddleOCR 纯 C# PP-OCRv6 推理，
         无 ONNX Runtime / OpenCV 原生依赖，AOT 友好。模型包经
         ModelProvider 契约与核心包版本解耦（ChineseV6Tiny 1.0.0 传
         ModelProvider 1.0.0，与核心 2.0.0 的同名依赖不冲突） -->
    <PackageVersion Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" Version="1.0.0" />
    <!-- sqlite-vec（ROADMAP Phase 2 语义搜图探针）：向量检索 SQLite 扩展，
         NuGet 移植包随 runtimes 分发 win/linux/osx 原生件（vec0.dll/vec0.so），
         与 PalORM 的 SQLite3MC 引擎经 load_extension 共存（探针测试锁定）。
         引用它的项目：NasSystem.IntegrationTests（能力探针）、
         NasSystem.Infrastructure（语义索引实现，探针通过后落地） -->
    <PackageVersion Include="HiraokaHyperTools.sqlite-vec" Version="0.1.9" />
    <!-- CLIP 图文编码（ROADMAP Phase 2 语义搜图）：ElBruno.LocalEmbeddings
         纯托管 ONNX Runtime 推理 + ImageSharp 预处理，MIT。模型四件套
         （vision_model/text_model/vocab/merges，Xenova/clip-vit-base-patch32）
         不入库，首次启用时下载到数据目录（探针与实现共用该契约） -->
    <PackageVersion Include="ElBruno.LocalEmbeddings.ImageEmbeddings" Version="1.6.4" />
  </ItemGroup>
</Project>