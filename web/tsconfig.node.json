{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    // 与 tsconfig.json 同：跳过库内部检查，2026-10-17 体检结论见那边注释
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* vite.config.ts 用 node:url 与 process，TS 6.0 起 types 默认空列表，需显式列出 */
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
