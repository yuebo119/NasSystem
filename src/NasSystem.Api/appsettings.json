{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PalORM": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "PalORM": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/nas.db"
  },
  "Jwt": {
    "SecretKey": "<SET-VIA-ENV>",
    "Issuer": "NasSystem",
    "Audience": "NasSystemUsers",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ClockSkewSeconds": 30
  },
  "Thumbnails": {
    "CacheDirectory": "temp/thumbnails",
    "DefaultWidth": 200,
    "DefaultHeight": 200,
    "MaxWidth": 1920,
    "MaxHeight": 1080,
    "CacheExpirationHours": 168,
    "JpegQuality": 82
  },
  "AllowedHosts": "*"
}
