{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/nas.db"
  },
  "Jwt": {
    "SecretKey": "NasSystem_Super_Secret_Key_2025_Must_Be_At_Least_32_Characters_Long",
    "Issuer": "NasSystem",
    "Audience": "NasSystemUsers",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ClockSkewSeconds": 30
  },
  "NasSystem": {
    "DataPath": "data",
    "StoragePath": "storage",
    "TempPath": "temp",
    "MaxUploadSizeMB": 10240,
    "ChunkSizeMB": 10
  },
  "Thumbnails": {
    "CacheDirectory": "temp/thumbnails",
    "DefaultWidth": 200,
    "DefaultHeight": 200,
    "MaxWidth": 1920,
    "MaxHeight": 1080,
    "CacheExpirationHours": 168,
    "JpegQuality": 85
  },
  "AllowedHosts": "*"
}
