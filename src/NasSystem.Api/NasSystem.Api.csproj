<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>NasSystem.Api</RootNamespace>
    <AssemblyName>NasSystem.Api</AssemblyName>
    <Description>NAS System API 层 - Web API 入口、中间件、端点</Description>
    
    <!-- 禁用 Native AOT：数据层已换 PalORM（宣称支持全链路 AOT），
         但链路里还有 DomainEventDispatcher 的反射派发与 Serilog 配置面待处理，
         未做全链路验证前不自声称兼容（ITM-N8 的教训） -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    
    <!-- 启用 HTTP/2 和压缩 -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NasSystem.Application\NasSystem.Application.csproj" />
    <ProjectReference Include="..\NasSystem.Infrastructure\NasSystem.Infrastructure.csproj" />
    <ProjectReference Include="..\NasSystem.Shared\NasSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenAPI / Scalar（.NET 10 原生 MapOpenApi，Swashbuckle 无代码引用已移除） -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />

    <!-- 日志集成 -->
    <PackageReference Include="Serilog.AspNetCore" />
    
    <!-- JWT 认证 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
