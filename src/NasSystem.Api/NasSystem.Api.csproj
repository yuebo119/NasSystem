<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>NasSystem.Api</RootNamespace>
    <AssemblyName>NasSystem.Api</AssemblyName>
    <Description>NAS System API 层 - Web API 入口、中间件、端点</Description>
    
    <!-- 禁用 Native AOT (EF Core 不支持) -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    
    <!-- 启用 HTTP/2 和压缩 -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NasSystem.Application\NasSystem.Application.csproj" />
    <ProjectReference Include="..\NasSystem.Infrastructure\NasSystem.Infrastructure.csproj" />
    <ProjectReference Include="..\NasSystem.Shared\NasSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenAPI / Scalar（.NET 10 原生 MapOpenApi，Swashbuckle 无代码引用已移除） -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />

    <!-- EF 设计期工具（dotnet ef 命令要求启动项目引用，PrivateAssets 不传递） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    
    <!-- 日志集成 -->
    <PackageReference Include="Serilog.AspNetCore" />
    
    <!-- JWT 认证 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
