<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NasSystem.Infrastructure</RootNamespace>
    <AssemblyName>NasSystem.Infrastructure</AssemblyName>
    <Description>NAS System 基础设施层 - 数据访问、外部服务、文件系统</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NasSystem.Domain\NasSystem.Domain.csproj" />
    <ProjectReference Include="..\NasSystem.Application\NasSystem.Application.csproj" />
    <ProjectReference Include="..\NasSystem.Shared\NasSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 数据访问：PalORM（SQLite 方言）。SourceGen 必须显式引用——
         PalORM.Sqlite 的 nuspec 不依赖它，漏掉时生成器完全不产出，
         运行期报 "Type 'X' is not registered"。 -->
    <PackageReference Include="PalORM.Sqlite" />
    <PackageReference Include="PalORM.SourceGen" />

    <!-- Options.ConfigurationExtensions：提供 Configure&lt;T&gt;(IConfigurationSection)
         重载。IOptions&lt;T&gt; 本身由 net11 SDK 自动提供，无需显式引用；
         这个绑定扩展原先靠 Serilog.AspNetCore 传递依赖间接获得，
         删掉 Serilog 后必须显式声明，否则编译报 CS1503 -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />

    <!-- Microsoft.Data.Sqlite.Core：代码直接 catch SqliteException 判定完整性
         冲突（PalormUnitOfWork）。显式声明把托管包装层钉在 rc.2，高于 PalORM.Sqlite
         传递的 rc.1，并与 Benchmark 的 ADO.NET 地板臂同版本；原生引擎仍走
         PalORM 的 SQLite3MC 包，故只引 Core 不引元包（元包会多带一份 e_sqlite3）。 -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />

    <!-- JWT 认证 -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />

  </ItemGroup>

  <ItemGroup>
    <!-- 版本收敛至 Directory.Build.props 单一真源（原 csproj 覆盖条目会把版本钉低于中央） -->
    <PackageReference Include="SkiaSharp" />

    <!-- OCR（ROADMAP Phase 2）：SimdPaddleOCR 纯 C# PP-OCRv6 推理 +
         ChineseV6Tiny 模型（内嵌 Assembly 资源，不落临时文件）。
         图像解码复用已有 SkiaSharp（README 的 SkiaSharp 集成路径），
         不引 ImageSharp（Split License，且项目已有解码器） -->
    <PackageReference Include="Sdcb.SimdPaddleOCR" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" />
  </ItemGroup>

</Project>
