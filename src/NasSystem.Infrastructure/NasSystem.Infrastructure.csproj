<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NasSystem.Infrastructure</RootNamespace>
    <AssemblyName>NasSystem.Infrastructure</AssemblyName>
    <Description>NAS System 基础设施层 - 数据访问、外部服务、文件系统</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NasSystem.Domain\NasSystem.Domain.csproj" />
    <ProjectReference Include="..\NasSystem.Application\NasSystem.Application.csproj" />
    <ProjectReference Include="..\NasSystem.Shared\NasSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 数据访问：PalORM（SQLite 方言）。SourceGen 必须显式引用——
         PalORM.Sqlite 的 nuspec 不依赖它，漏掉时生成器完全不产出，
         运行期报 "Type 'X' is not registered"。 -->
    <PackageReference Include="PalORM.Sqlite" />
    <PackageReference Include="PalORM.SourceGen" />

    <!-- JWT 认证 -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />

    <!-- 日志 -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />

    <!-- 覆盖传递依赖的安全漏洞版本 -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本收敛至 Directory.Build.props 单一真源（原 csproj 覆盖条目会把版本钉低于中央） -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

</Project>
