<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NasSystem.Infrastructure</RootNamespace>
    <AssemblyName>NasSystem.Infrastructure</AssemblyName>
    <Description>NAS System 基础设施层 - 数据访问、外部服务、文件系统</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NasSystem.Domain\NasSystem.Domain.csproj" />
    <ProjectReference Include="..\NasSystem.Application\NasSystem.Application.csproj" />
    <ProjectReference Include="..\NasSystem.Shared\NasSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 数据访问 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Dapper" />
    
    <!-- JWT 认证 -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    
    <!-- 任务调度 -->
    
    <!-- 日志 -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    
    <!-- 覆盖传递依赖的安全漏洞版本 -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Dapper" Version="2.1.66" />
    <PackageVersion Update="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Update="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Update="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Update="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
