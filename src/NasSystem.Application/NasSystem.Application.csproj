<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NasSystem.Application</RootNamespace>
    <AssemblyName>NasSystem.Application</AssemblyName>
    <Description>NAS System 应用层 - 业务用例、命令查询、DTO</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NasSystem.Domain\NasSystem.Domain.csproj" />
    <ProjectReference Include="..\NasSystem.Shared\NasSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部工具（如 KeyedGate 分片闸）放行单测直接覆盖分片互斥语义 -->
    <InternalsVisibleTo Include="NasSystem.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 缓存抽象。Configuration.Abstractions 自 net11 SDK 起自动提供，
         显式引用会报 NU1510，故移除 -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

</Project>
