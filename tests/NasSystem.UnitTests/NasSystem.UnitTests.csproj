<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NasSystem.UnitTests</RootNamespace>
    <AssemblyName>NasSystem.UnitTests</AssemblyName>
    <Description>NAS System 单元测试</Description>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NasSystem.Domain\NasSystem.Domain.csproj" />
    <ProjectReference Include="..\..\src\NasSystem.Application\NasSystem.Application.csproj" />
    <!-- Infrastructure：转码参数构建是纯静态函数（无 IO），住在这里；
         单测直接覆盖分支，不必起真实 ffmpeg -->
    <ProjectReference Include="..\..\src\NasSystem.Infrastructure\NasSystem.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\NasSystem.Shared\NasSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- xunit.v3 自带测试平台，VSTest runner adapter（xunit.runner.visualstudio）不再需要 -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Moq" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MTP 模式覆盖率扩展：VSTest 的 collect 参数在 MTP 模式不可用，改由该包提供 -->
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <!-- 版本收敛至 Directory.Build.props 单一真源（原 csproj 覆盖条目会把版本钉低于中央） -->

</Project>
